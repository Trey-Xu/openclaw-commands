{
  "name": "openclaw-commands",
  "private": true,
  "version": "2026.5.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-feed.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js",
    "test": "node --test tests/*.test.mjs",
    "check:version-consistency": "node scripts/check-version-consistency.mjs",
    "check:commands": "node scripts/validate-commands.mjs",
    "check:cli-sync": "node scripts/check-official-cli-sync.mjs",
    "check:cli-deep-sync": "node scripts/check-official-cli-deep-sync.mjs",
    "detect:drift": "node scripts/detect-upstream-drift.mjs",
    "bump:openclaw": "node scripts/bump-openclaw-version.mjs",
    "update:bundled-release": "node scripts/update-bundled-release.mjs",
    "check": "npm run check:version-consistency && npm run check:commands && npm run check:cli-sync && npm run check:cli-deep-sync && npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "prismjs": "^1.30.0",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "vite": "^5.4.21"
  }
}
